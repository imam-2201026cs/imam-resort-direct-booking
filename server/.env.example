# Server environment variables (names only; copy to .env and fill in)
NODE_ENV=development
PORT=4000
MONGODB_URI=
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# lax (default) when the client proxies /api to this server; none only for a cross-site deployment
COOKIE_SAMESITE=lax
# Optional: AI enquiry router. Without a key the router falls back to deterministic rules.
ANTHROPIC_API_KEY=
AI_MODEL=
# Optional: enables DB-backed tests (needs a replica set, e.g. a free Atlas cluster)
MONGODB_URI_TEST=
